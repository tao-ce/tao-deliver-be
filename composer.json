      "url": "https://github.com/oat-sa/bundle-filesystem-document-manager"
    },
    {
      "type": "vcs",
      "url": "https://github.com/oat-sa/bundle-qti"
    },
    {
      "type": "vcs",
      "url": "https://github.com/oat-sa/lib-em-php-client"
