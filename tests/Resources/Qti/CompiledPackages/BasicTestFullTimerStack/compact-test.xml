<assessmentTest xmlns="http://www.imsglobal.org/xsd/imsqti_v2p1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" identifier="BasicTestFullTimerStack" title="Basic Test Full Timer Stack" xsi:schemaLocation="http://www.taotesting.com/xsd/qticompact_v1p0.xsd">
